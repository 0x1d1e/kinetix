# Kinetix bootstrap seed (first run only).
#
# Kinetix is DB-authoritative: this file is read once, when the database has no
# providers yet, and is ignored on every subsequent start. After first run,
# manage everything from the dashboard (/admin) or the admin API.
#
# Copy to `config.toml` and edit. Point the server at it with
# KINETIX_BOOTSTRAP_FILE (see .env.example).

# --- Virtual keys (client credentials) -------------------------------------
# The key value is generated server-side and printed once at first startup.
[[virtual_keys]]
name = "Local Dev Key"
owner = "Admin"
tag = "dev"
allowed_models = ["*"]        # "*", exact names, or prefixes like "gemini-*"
allowed_providers = []         # empty = any configured provider
allowed_ips = []               # CIDRs; empty = any client IP
body_logging = false           # opt-in short-retention request/response logging
rpm_limit = 600               # requests per minute (omit for unlimited)
tpm_limit = 1000000           # tokens per minute
# max_concurrent_requests = 8  # per-key simultaneous requests; omit or use 0 for unlimited
daily_budget = 50.0           # USD
monthly_budget = 200.0        # USD

# --- Upstream providers ----------------------------------------------------
[[providers]]
name = "Google Gemini"
base_url = "https://generativelanguage.googleapis.com/v1beta"
wire_format = "gemini"        # gemini | openai | anthropic
auth_scheme = "custom_header" # bearer | custom_header | query_param
custom_header_name = "x-goog-api-key"
timeout_ms = 120000
capability_mode = "permissive" # permissive | strict
models_path = "/models"        # for model discovery (optional)
follow_redirects = false
credential_hosts = ""          # comma-separated auth hosts; empty = base_url host
allow_insecure_tls = false
# rate_limit_rules = { target = { statuses = [403, 404] } }

  # One or more upstream credentials ("accounts") for this provider.
  [[providers.accounts]]
  label = "Gemini Key 1"
  api_key = "REPLACE_WITH_REAL_KEY"
  priority = 1
  weight = 1
  quota_type = "none"         # none | daily | monthly | rolling
  # quota_window_s = 3600     # used by rolling quotas

  # Models this provider exposes. Add more as needed.
  [[providers.models]]
  upstream_id = "gemini-3.6-flash"   # the id sent upstream
  display_name = "Gemini 3.6 Flash"  # shown in the dashboard / model list
  enabled = true
  context_window = 1048576
  max_output_tokens = 65536
  capabilities = ["text", "vision", "reasoning", "tool_calling"]
  # prices = { input_per_1m = 0.10, output_per_1m = 0.40 }  # optional
  # parameters = { temperature = { supported = true } }
  # thinking_map = { levels = { high = "high" } }
  # extra_request = { service_tier = "auto" }

# --- Aliases (stable client-facing model names) ----------------------------
[[aliases]]
alias = "coder"
target_type = "model"                  # model | route
target = "Google Gemini/gemini-3.6-flash"

# --- Routes (named fallback groups across accounts/models) -----------------
# [[routes]]
# name = "smart"
# description = "Primary then fallback"
# strategy = "priority"                # priority | round-robin | weighted | least-used | adaptive
# fallback_triggers = { on429 = true, onQuota = true, on5xx = true, onTimeout = true }
# portability_policy = "strip_with_warning"  # reject | strip_with_warning (FR-2.11)
# cache_affinity = false               # FR-7.3 prompt-cache-aware sticky routing
# sticky_routing = false               # FR-7.5 prefer the same target per session
# max_attempts = 3
# max_concurrent_requests = 8  # per-Route simultaneous requests; omit or use 0 for unlimited
# [[routes.targets]]
# model = "Google Gemini/gemini-3.6-flash"
# # account = "Gemini Key 1"            # omit to use the provider account pool
# priority = 1
# weight = 1
# param_overrides = { temperature = 0.2 }
# # Optional typed eligibility predicate (FR-12.3). Facts: has_tools,
# # has_images, has_reasoning, frontend, requested_model, requested_route,
# # key_tag, input_tokens, target_capability, target_context_window, ...
# predicate = { expr = { fact = "has_tools", op = "eq", value = true }, when_unknown = "skip" }
